# ##############################################################################
# EcoNova GreenLens - Git Ignore File
# ##############################################################################

# --- System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDEs and Editors ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Node / Frontend (Next.js) ---
node_modules/
npm-debug.log*
yarn-error.log*
yarn-debug.log*
.pnpm-debug.log*
.lerna/

# Next.js build output
.next/
out/
build/
dist/

# TypeScript build info
*.tsbuildinfo

# Cypress / Testing video/screenshot directories
cypress/videos/
cypress/screenshots/

# --- Python / Backend ---
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python runner when a script is given a spec file
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nosenv/
.pytest_cache/
.mypy_cache/
.hypothesis/
.poetry/
.pdm/
.pipenv/
.venv/
venv/
ENV/
env/

# Environments / Credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key

# --- Project-Specific / Cache / Temp Files ---
api_test_out.json
hash_results.txt
backend/backend_cache.json
